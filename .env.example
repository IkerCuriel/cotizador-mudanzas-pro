# Copiar como .env.local. Las variables VITE_ son PUBLICAS en el navegador.
# Nunca poner aquí service_role, sb_secret_, contraseñas ni secretos de pago.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: nuevo origen HTTPS al migrar a otro alojamiento o dominio; sin / al final.
# Si se omite, se usa CF_PAGES_URL o el enlace público de site.config.js.
VITE_SITE_URL=

# Datos PÚBLICOS del responsable del tratamiento. Completar y revisar el aviso.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_EMAIL=
VITE_PRIVACY_READY=false

# Nombre comercial público, distinto del nombre legal si corresponde.
VITE_BUSINESS_NAME=Equipo de mudanzas familiar

# Avisos opcionales al teléfono: activar después de probar servidor y permisos.
# Solo la clave VAPID PÚBLICA; nunca VAPID_PRIVATE_KEY ni secretos webhook aquí.
VITE_WEB_PUSH_ENABLED=false
VITE_WEB_PUSH_PUBLIC_KEY=
