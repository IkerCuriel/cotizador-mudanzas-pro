# Copiar como .env.local. Las variables VITE_ son PUBLICAS en el navegador.
# Nunca poner aquí service_role, sb_secret_, contraseñas ni secretos de pago.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL final https://nombre.pages.dev (o dominio propio); sin / al final.
# Cloudflare proporciona CF_PAGES_URL durante la compilación si se omite.
VITE_SITE_URL=

# Datos PÚBLICOS del responsable del tratamiento. Completar y revisar el aviso.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_EMAIL=
VITE_PRIVACY_READY=false

# Nombre comercial público, distinto del nombre legal si corresponde.
VITE_BUSINESS_NAME=Equipo de mudanzas familiar
